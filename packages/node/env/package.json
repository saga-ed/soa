{
    "name": "@saga-ed/soa-env",
    "version": "0.2.0",
    "private": false,
    "type": "module",
    "description": "Environment identity and declared capabilities: one module reads account, lane and profile, and returns fail-closed capabilities that call sites consume instead of branching on env names.",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./testing": {
            "types": "./dist/testing.d.ts",
            "default": "./dist/testing.js"
        },
        "./eslint": {
            "types": "./dist/eslint.d.ts",
            "default": "./dist/eslint.js"
        },
        "./aws": {
            "types": "./dist/aws.d.ts",
            "default": "./dist/aws.js"
        }
    },
    "bin": {
        "soa-env-lint-ratchet": "./dist/ratchet-cli.js"
    },
    "files": [
        "dist",
        "README.md"
    ],
    "scripts": {
        "build": "tsup",
        "check-types": "tsc --noEmit",
        "test": "vitest run",
        "lint": "eslint src/",
        "clean": "rm -rf dist"
    },
    "peerDependencies": {
        "@aws-sdk/client-sts": "^3.968.0",
        "eslint": "^8.57"
    },
    "peerDependenciesMeta": {
        "@aws-sdk/client-sts": {
            "optional": true
        },
        "eslint": {
            "optional": true
        }
    },
    "devDependencies": {
        "@aws-sdk/client-sts": "^3.968.0",
        "@saga-ed/soa-typescript-config": "workspace:*",
        "@types/node": "^24.0.3",
        "@typescript-eslint/parser": "^8.50.0",
        "eslint": "8.57.1",
        "tsup": "^8.5.0",
        "typescript": "5.8.2",
        "vitest": "^1.6.1"
    },
    "publishConfig": {
        "registry": "https://saga-531314149529.d.codeartifact.us-west-2.amazonaws.com/npm/saga_js/",
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/saga-ed/soa.git",
        "directory": "packages/node/env"
    }
}
