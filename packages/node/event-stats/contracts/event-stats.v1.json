{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "reportId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "identity": {
      "type": "object",
      "properties": {
        "service": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "environment": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "deployment": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "instance": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "broker": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "vhost": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "service",
        "environment",
        "deployment",
        "revision",
        "instance",
        "broker",
        "vhost"
      ],
      "additionalProperties": false
    },
    "epoch": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "sequence": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "startedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "observedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "elapsedMs": {
      "type": "number",
      "minimum": 0
    },
    "capabilities": {
      "minItems": 1,
      "maxItems": 2,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "producer",
          "consumer"
        ]
      }
    },
    "streams": {
      "maxItems": 1024,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "stream": {
            "type": "object",
            "properties": {
              "role": {
                "type": "string",
                "enum": [
                  "producer",
                  "consumer"
                ]
              },
              "exchange": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "queue": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "consumer": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "eventType": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "eventVersion": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "role",
              "exchange",
              "eventType"
            ],
            "additionalProperties": false
          },
          "counters": {
            "type": "object",
            "properties": {
              "publishAttempts": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "publishAccepted": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "publishConfirmed": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "publishFailures": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "deliveries": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "redeliveries": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "commits": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "duplicates": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "processingFailures": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "ackIssued": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "ackFailed": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "nackIssued": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "nackFailed": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "requeues": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "publishAttempts",
              "publishAccepted",
              "publishConfirmed",
              "publishFailures",
              "deliveries",
              "redeliveries",
              "commits",
              "duplicates",
              "processingFailures",
              "ackIssued",
              "ackFailed",
              "nackIssued",
              "nackFailed",
              "requeues"
            ],
            "additionalProperties": false
          },
          "latestSuccessAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
              },
              {
                "type": "null"
              }
            ]
          },
          "failureReasons": {
            "type": "object",
            "properties": {
              "transport": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "backpressure": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "envelope": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "unsupported": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "schema": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "database": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "handler": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "commit": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "transport",
              "backpressure",
              "envelope",
              "unsupported",
              "schema",
              "database",
              "handler",
              "commit"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "stream",
          "counters",
          "latestSuccessAt",
          "failureReasons"
        ],
        "additionalProperties": false
      }
    },
    "diagnostics": {
      "type": "object",
      "properties": {
        "droppedObservations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "reportingFailures": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "oversizedReports": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "saturatedCounters": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "droppedObservations",
        "reportingFailures",
        "oversizedReports",
        "saturatedCounters"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "reportId",
    "identity",
    "epoch",
    "sequence",
    "startedAt",
    "observedAt",
    "elapsedMs",
    "capabilities",
    "streams",
    "diagnostics"
  ],
  "additionalProperties": false
}
